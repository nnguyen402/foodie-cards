{
  "expo": {
    "name": "Foodie Cards",
    "slug": "foodie-cards",
    "scheme": "foodiecards",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a receipt photo to review your purchases.",
          "cameraPermission": "Take a receipt photo to review your purchases.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F1E8"
      }
    }
  }
}
