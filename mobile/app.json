{
  "expo": {
    "name": "Foodie Cards",
    "slug": "foodie-cards",
    "scheme": "foodiecards",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "Foodie Cards uses your location to centre the map on restaurants near you." }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F1E8"
      }
    }
  }
}
